#!/usr/bin/env python3
import os, subprocess, curses

VAULT = os.path.expanduser('~/Vault')
SECTIONS = ['Writings!', 'Stash']

for d in SECTIONS + ['Music']:
    os.makedirs(os.path.join(VAULT, d), exist_ok=True)

def run_menu(stdscr, title, options):
    row = 0
    # Initialize Cyberpunk Color Palette
    curses.start_color()
    curses.init_pair(1, curses.COLOR_CYAN, curses.COLOR_BLACK)
    curses.init_pair(2, curses.COLOR_MAGENTA, curses.COLOR_BLACK)
    
    while True:
        stdscr.clear()
        # Force the entire terminal background to absolute black
        stdscr.bkgd(' ', curses.color_pair(1))
        
        h, w = stdscr.getmaxyx()
        stdscr.addstr(2, w//2 - len(title)//2, title, curses.color_pair(2) | curses.A_BOLD)
        
        for i, opt in enumerate(options):
            x = w//2 - len(opt)//2
            y = 5 + i
            if i == row:
                stdscr.attron(curses.color_pair(2) | curses.A_REVERSE)
                stdscr.addstr(y, x, opt)
                stdscr.attroff(curses.color_pair(2) | curses.A_REVERSE)
            else:
                stdscr.addstr(y, x, opt, curses.color_pair(1))
        
        key = stdscr.getch()
        if key == curses.KEY_UP and row > 0: row -= 1
        elif key == curses.KEY_DOWN and row < len(options)-1: row += 1
        elif key in [10, 13]: return options[row]

def main(stdscr):
    curses.curs_set(0)
    while True:
        choice = run_menu(stdscr, '✦ KAUSHIK VAULT ✦', SECTIONS + ['Select Music', 'Stop Music', 'Exit'])
        if choice == 'Exit': break
        elif choice == 'Select Music':
            curses.endwin()
            subprocess.run(['vault-music'])
        elif choice == 'Stop Music':
            subprocess.run(['pkill', '-f', 'mpv.*--no-video'], stderr=subprocess.DEVNULL)
        else:
            while True:
                files = [f for f in os.listdir(os.path.join(VAULT, choice)) if f.endswith('.txt')]
                f_choice = run_menu(stdscr, f'[ {choice.upper()} ]', ['+ Create New'] + files + ['< Back'])
                if f_choice == '< Back': break
                elif f_choice == '+ Create New':
                    curses.echo(); curses.curs_set(1)
                    stdscr.clear()
                    stdscr.bkgd(' ', curses.color_pair(1))
                    stdscr.addstr(2, 2, 'Enter Title: ', curses.color_pair(2))
                    name = stdscr.getstr(2, 15).decode('utf-8')
                    curses.noecho(); curses.curs_set(0)
                    if name:
                        if not name.endswith('.txt'): name += '.txt'
                        f_choice = name
                    else: continue
                curses.endwin()
                subprocess.run(['micro', os.path.join(VAULT, choice, f_choice)])

if __name__ == '__main__': 
    curses.wrapper(main)
